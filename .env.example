# Copy this to .env and fill in / adjust as needed.
# Local dev (WSL, no GPU) -> leave LLM_BACKEND=ollama
# On the AMD pod          -> set LLM_BACKEND=vllm and point VLLM_BASE_URL
#                             at your running `vllm serve` instance

LLM_BACKEND=ollama

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_SMALL_MODEL=qwen2.5:3b
OLLAMA_LARGE_MODEL=qwen2.5:7b

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed
VLLM_SMALL_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_LARGE_MODEL=Qwen/Qwen2.5-14B-Instruct

DATABASE_URL=postgresql+asyncpg://ara:ara_dev_pw@postgres:5432/ara_db
REDIS_URL=redis://redis:6379/0

DEFAULT_EXECUTION_MODE=sequential

WEB_SEARCH_ENABLED=true
CODE_EXEC_ENABLED=true

APP_ENV=dev
LOG_LEVEL=INFO
